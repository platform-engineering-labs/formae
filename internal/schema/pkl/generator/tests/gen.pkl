/// Local Tag class for testing (mirrors the pattern used by resource plugins)
local class Tag {
    key: String
    value: String
}

@formae.ResourceHint
local class SimpleFoo extends formae.Resource{
    x: Int
    name: String
}

@formae.ResourceHint
local class ComplexBar extends formae.Resource {
    items: Listing<String>
    metadata: Mapping<String, Any>
    optional: String?
}

@formae.ResourceHint
local class FloatResource extends formae.Resource {
    percentage: Float
    count: Int
    name: String
}

@formae.ResourceHint
local class TestResource extends formae.Resource {
    type = "FakePlugin::Service::TestResource"

    @formae.FieldHint
    size: Int?

    @formae.FieldHint
    tags: Listing<Tag>

    @formae.FieldHint
    bucketName: String
}

/// A provider-local base that merely shares the name `Resource` — unrelated to
/// formae.Resource. Classification matches on class identity, not on the name.
local open class Resource {
    label: String
}

/// Extends the same-named local base, not formae's: annotating it changes
/// nothing, it is still not a formae resource.
@formae.ResourceHint
local class ImposterResource extends Resource {
    @formae.FieldHint
    name: String
}

/// Mutual-exclusivity check: exactly one of the two candidate values is non-null.
const local function isExclusive(a: Any, b: Any): Boolean = (a == null) != (b == null)

/// A nested type carrying a mutual-exclusivity constraint on two optional
/// fields (exactly one of `run`/`uses` may be set).
local class XorStep {
    run: String?(isExclusive(this, uses))
    uses: String?
}

@formae.ResourceHint
local class WorkflowResource extends formae.Resource {
    type = "FakePlugin::Actions::Workflow"

    @formae.FieldHint
    steps: Listing<XorStep>
}

/// Two nested carriers that differ only in the type of their single property.
/// A value fits exactly one of them, so which member a union resolves to is
/// observable.
local class IntHolder {
    n: Int
}

local class StrHolder {
    n: String
}

@formae.ResourceHint
local class IntThenStrResource extends formae.Resource {
    type = "FakePlugin::Union::IntThenStr"

    @formae.FieldHint
    holder: IntHolder|StrHolder
}

@formae.ResourceHint
local class StrThenIntResource extends formae.Resource {
    type = "FakePlugin::Union::StrThenInt"

    @formae.FieldHint
    holder: StrHolder|IntHolder
}

@formae.ResourceHint
local class XorThenStrResource extends formae.Resource {
    type = "FakePlugin::Union::XorThenStr"

    @formae.FieldHint
    step: XorStep|StrHolder
}

@formae.ResourceHint
local class StrThenXorResource extends formae.Resource {
    type = "FakePlugin::Union::StrThenXor"

    @formae.FieldHint
    step: StrHolder|XorStep
}

/// Holds a nested class, so a malformed envelope offered in its place reaches
/// the envelope branches of the conversion.
@formae.ResourceHint
local class HolderResource extends formae.Resource {
    type = "FakePlugin::Union::Holder"

    @formae.FieldHint
    holder: StrHolder
}

/// A member carrying a property that conversion skips, whose schema default
/// cannot be evaluated. Reading it is what a converted value must not do.
local class UnsafeDefaultHolder {
    n: String
    output: String = throw("the skipped property was evaluated")
}

@formae.ResourceHint
local class SkippedDefaultResource extends formae.Resource {
    type = "FakePlugin::Union::SkippedDefault"

    @formae.FieldHint
    holder: UnsafeDefaultHolder|StrHolder
}

/// Two nested carriers with disjoint required properties. A value carrying one
