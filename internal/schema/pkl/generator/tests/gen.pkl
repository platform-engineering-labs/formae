    //metadata = new Mapping {
    //    ["key1"] = "value1"
    //    ["key2"] = 123
    //}
    optional = "optional value"
    label = "complex"
}

local floatProperties: Dynamic = new Dynamic {
    percentage = 0.75
    count = 10
    name = "float-test"
    label = "float-res"
}

local resourceProperties: Dynamic = new Dynamic {
    bucketName = "my-test-bucket"
    size = 1024
    tags = new Listing {
        new Dynamic {
            key = "Environment"
            value = "test"
        }
        new Dynamic {
            key = "Owner"
            value = "team-a"
        }
    }
    label = "my-bucket"
}

local workflowProperties: Dynamic = new Dynamic {
    // `run` is absent (only `uses` is set) — the sibling that actually
    // carries the mutual-exclusivity constraint is the one being defaulted.
    steps = new Listing {
        new Dynamic { uses = "actions/checkout@v4" }
    }
    label = "wf"
}

local defaultsProperties: Dynamic = new Dynamic {
    label = "defaults"
}

// A string-valued `n` fits StrHolder and no other member.
local stringHolderProperties: Dynamic = new Dynamic {
    holder = new Dynamic { n = "abc" }
    label = "holder"
}

// Neither `run` nor `uses` is present, so XorStep's mutual-exclusivity
// constraint cannot hold; only StrHolder fits.
local stringStepProperties: Dynamic = new Dynamic {
    step = new Dynamic { n = "abc" }
    label = "step"
}

// A listing fits neither Int nor String, so no member of the union fits.
local unmatchableHolderProperties: Dynamic = new Dynamic {
    holder = new Dynamic { n = new Listing { "abc" } }
    label = "holder"
}

// A member that fits the value, whose skipped property carries an
// unevaluatable default.
local skippedDefaultProperties: Dynamic = new Dynamic {
    holder = new Dynamic { n = "abc" }
    label = "skipped"
}

/// Builds the $res envelope the agent records for a reference to another
/// resource's property, optionally omitting one of its keys.
local function reference(omitted: String?): Mapping =
    let (env = Map(
        "$res", true,
        "$label", "vpc",
        "$stack", "network",
        "$type", "TestProvider::EC2::VPC",
        "$property", "VpcId",
        "$value", "vpc-0123456789"
    ))
    (if (omitted == null) env else env.remove(omitted)).toMapping()

/// The same envelope carrying a recorded value of the caller's choosing.
local function referenceValued(recorded: Any): Mapping =
    reference("$value").toMap().put("$value", recorded).toMapping()

/// The same envelope with one of its keys replaced, for the shapes that carry a
/// `$res` key without being a reference.
local function referenceWith(key: String, replacement: Any): Mapping =
    reference(null).toMap().put(key, replacement).toMapping()

/// The envelope the agent records for a value it holds itself, rather than a
/// reference to one another resource holds.
local function recordedValue(omitted: String?): Mapping =
    let (env = Map(
        "$value", "s3cret",
        "$visibility", "Clear",
        "$strategy", "Update"
    ))
    (if (omitted == null) env else env.remove(omitted)).toMapping()

/// The envelope a property carries when it is bound to one of a generator's
/// outputs, in the authored shape extraction emits, optionally omitting one of
/// its keys.
local function binding(omitted: String?): Mapping =
    let (env = Map(
        "$gen", true,
        "$label", "db-password-gen",
        "$stack", "shared-secrets",
        "$output", "value",
        "$visibility", "Opaque"
    ))
    (if (omitted == null) env else env.remove(omitted)).toMapping()

/// The same binding with the keys a recorded value is written from beside its
/// own marker, which is the shape a binding the agent has resolved is stored in.
local function resolvedBinding(): Mapping =
    binding(null).toMap()
        .put("$value", "sha256:digest")
        .put("$strategy", "Update")
        .toMapping()

/// A binding as it arrives inside a split embedded template: the pre-processing
/// puts the framed envelope in among the literal segments, deserialized from
/// JSON and so a Dynamic rather than a Map.
local function embeddedBindingPart(): Dynamic = new Dynamic {
    ["$gen"] = true
    ["$label"] = "db-password-gen"
    ["$stack"] = "shared-secrets"
    ["$output"] = "value"
    ["$visibility"] = "Opaque"
}

/// The envelope the agent's extract pre-processing produces for a template
/// carrying references: alternating literal segments and reference envelopes.
local function embedded(parts: Listing?): Mapping =
    let (env = Map("$embed", true))
    (if (parts == null) env else env.put("$templateParts", parts)).toMapping()

/// Renders a resource whose `target` field carries `env`, and returns what that
/// field rendered to.
///
/// Rendering a resource yields a map, so the converted value is returned as it
/// stands: an envelope converts to a carrier that is not always an instance of
/// the declared field type — `FakeEmbed` does not extend `formae.Embedded` —
/// and only the renderer ever reads it.
local function renderedTarget(res: Class, env: Any): Any =
    gen.applyResource(res, new Dynamic {
        target = env
        label = "ref"
    }, "Cannot render resource \"ref\" in stack \"default\"").getOrNull("target")

/// The diagnostic rendering that resource raises, or `null` when it renders.
local function renderFailure(res: Class, env: Any): String? =
    module.catchOrNull(() -> renderedTarget(res, env))

/// Applies an envelope to a union-typed field and names the member the union
/// resolved to. A value no member converts raises out of `applyResource`, so
/// the diagnostic itself is what the caller sees; `renderFailure` is what reads
/// that diagnostic.
local function selectedMember(res: Class, env: Any): String =
    renderedTarget(res, env).getClass().simpleName

/// Applies `setting` to a resource's union-typed `setting` field and returns
/// what that field came out as, so the member the union resolved to is
/// observable in the class of the result.
local function convertedSetting(res: Class, stored: Any): Any =
    let (result = gen.attemptApply(res, new Dynamic {
        setting = stored
        label = "scalar"
    }))
        if (result is gen.GenerationFailure) throw(gen.failureMessage(result))
        else (result as Typed).getPropertyOrNull("setting")

/// A value distinctive enough that finding it in a diagnostic can only mean the
/// diagnostic quoted the value it was given. It parses as none of the scalar
/// types and equals none of the string literals any test class declares.
local sentinel = "s3cr3t-sentinel-19f4c2"

/// The diagnostic a resource's conversion yields for `properties`.
local function failureFor(res: Class, properties: Dynamic): String =
    gen.failureMessage(gen.attemptApply(res, properties) as gen.GenerationFailure)

/// The diagnostic a `setting` field yields for a value it cannot convert.
local function settingFailure(res: Class): String =
    failureFor(res, new Dynamic {
        setting = sentinel
        label = "scalar"
    })

examples {
    ["Apply simple class"] {
        gen.apply(SimpleFoo, simpleProperties)
    }

    ["Apply complex class with collections"] {
        gen.apply(ComplexBar, complexProperties)
    }

    //["ApplyResource for Simple class fails when it is no resource"] {
    //    gen.applyResource(SimpleFoo, simpleProperties, "Cannot render resource \"simple\"")
    //}
    //
    //["ApplyResource for Complex class fails when it is no resource"] {
    //    gen.applyResource(ComplexBar, complexProperties, "Cannot render resource \"complex\"")
    //}
    //
    //["Apply resource class"] {
    //    gen.applyResource(TestResource, resourceProperties, "Cannot render resource \"test\"")
    //}

    ["Convert to map with types - simple"] {
        gen.genPklToMapWithTypes(new SimpleFoo { x = 42; name = "test"; label = "simple" }.toDynamic())
    }

    ["Convert to map with types - complex"] {
        gen.genPklToMap(new TestResource {
            bucketName = "my-test-bucket"
            label = "my-bucket"
        }.toDynamic())
    }

    ["Generate import statements"] {
        gen.generateImportStatements(new Mapping {
                ["__import_statement__"] = "@aws/s3.pkl"
                ["__type__"] = "Bucket"
        }.toMap())
    }

    ["Collect imports when there are no imports"] {
        gen.generateImportStatements(new Mapping {
                ["__import_statement__"] = "@aws/s3.pkl"
                ["__type__"] = "Bucket"
        }.toMap())
    }
}

facts {
    ["Simple class application preserves values"] {
        let (result = gen.apply(SimpleFoo, simpleProperties))
        result.x == 42 && result.name == "test"
    }

    ["Float class application preserves float values"] {
        let (result = gen.apply(FloatResource, floatProperties))
        result.percentage == 0.75 && result.count == 10 && result.name == "float-test"
    }

    ["Complex class handles collections"] {
        let (result = gen.apply(ComplexBar, complexProperties))
        result.items.length == 3 &&
        result.optional == "optional value"
    }

    ["Resource class inherits from formae.Resource"] {
        let (result = gen.apply(TestResource, resourceProperties))
        result.bucketName == "my-test-bucket"
    }

    ["Map conversion includes type information"] {
        let (testObj = new TestResource { bucketName = "my-test-bucket"; size = 1024; label = "my-bucket" }.toDynamic())
        let (result = gen.genPklToMapWithTypes(testObj))
        //result["__type__"] == "FakeAWS::Suckets::TestResource" &&
        result["bucketName"] == "my-test-bucket" &&
        result["label"] == "my-bucket"
    }

    ["Import statement generation filters base types"] {
        let (parsedData = new Mapping {
            ["resource"] = new Mapping {
                ["__import__"] = "pkl:base"
                ["__type__"] = "String"
            }
        })
        let (imports = gen.generateImportStatements(parsedData.toMap()))
        !imports.contains("pkl:base")
    }

    ["Type conversion handles nullable types"] {
        let (result = gen.attemptApply(ComplexBar, new Dynamic {
            items = new Listing { "test" }
            optional = null
        }))
        !(result is gen.GenerationFailure) && (result as ComplexBar).optional == null
    }

    ["Should skip properties starting with double underscore"] {
        gen.shouldSkipPropertyName("__type__") == true &&
        gen.shouldSkipPropertyName("__import__") == true &&
        gen.shouldSkipPropertyName("__fullType__") == true &&
        gen.shouldSkipPropertyName("__metadata__") == true
    }

    ["Should skip system properties"] {
        gen.shouldSkipPropertyName("Properties") == true &&
        gen.shouldSkipPropertyName("Schema") == true &&
        gen.shouldSkipPropertyName("Fields") == true &&
        gen.shouldSkipPropertyName("output") == true
    }

    ["Should not skip regular properties"] {
        gen.shouldSkipPropertyName("bucketName") == false &&
        gen.shouldSkipPropertyName("label") == false &&
        gen.shouldSkipPropertyName("stack") == false &&
        gen.shouldSkipPropertyName("target") == false &&
        gen.shouldSkipPropertyName("size") == false &&
        gen.shouldSkipPropertyName("tags") == false &&
        gen.shouldSkipPropertyName("myCustomProperty") == false
    }

    ["Should handle edge cases"] {
        gen.shouldSkipPropertyName("") == false &&
        gen.shouldSkipPropertyName("_singleUnderscore") == false &&
        gen.shouldSkipPropertyName("property__") == false &&
        gen.shouldSkipPropertyName("PropertiesExtended") == false
    }

    ["parseModuleUri extracts correct import name from package URIs"] {
        gen.parseModuleUri("@oci/oci.pkl") == "oci" &&
        gen.parseModuleUri("@oci/objectstorage/bucket.pkl") == "bucket" &&
        gen.parseModuleUri("@aws/aws.pkl") == "aws" &&
        gen.parseModuleUri("@aws/types.pkl") == "types" &&
        gen.parseModuleUri("@azure/resources/resourcegroup.pkl") == "resourcegroup"
    }

    ["parseModuleUri handles full package URIs with fragments"] {
        gen.parseModuleUri("package://hub.example.com/pkg@1.0.0#/oci.pkl") == "oci" &&
        gen.parseModuleUri("package://hub.example.com/pkg@1.0.0#/objectstorage/bucket.pkl") == "bucket"
    }

    ["getImportInfo uses reflection to get module URI"] {
        // For a class defined in this test module (local file), getImportInfo returns
        // the placeholder since local file:// URIs aren't package URIs.
        // The important thing is that reflection works - parseModuleUri tests verify the parsing.
        let (tagClass = Tag.getClass())
        let (importInfo = gen.getImportInfo(tagClass))
        // Local file URIs return placeholder (which is expected)
        // For package URIs like @oci/oci.pkl, it would return "oci"
        importInfo == gen.importPlaceholder
    }

    // --- Resource classification tests ---

    ["direct formae.Resource subclass is a resource class"] {
        gen.isResourceClass(reflect.Class(TestResource)) == true
    }

    ["subclass reached through formae.Secret is a resource class"] {
        gen.isResourceClass(reflect.Class(secret.Secret)) == true
    }

    ["unrelated same-named Resource base is not a resource class"] {
        gen.isResourceClass(reflect.Class(Resource)) == false
    }

    ["class extending an unrelated same-named Resource is not a resource class"] {
        gen.isResourceClass(reflect.Class(ImposterResource)) == false
    }

    ["formae.SubResource subclass is not a resource class"] {
        gen.isResourceClass(reflect.Class(zone.ZoneConfig)) == false
    }

    // --- SubResource import statement tests ---

    ["generateImportStatements collects SubResource imports"] {
        // ZoneConfig is a SubResource defined in @testprovider/dns/zone.pkl.
        // parseValueEnhanced should add __import_statement__ for it so that
        // generateImportStatements picks it up.
        let (z = new zone.Zone {
            label = "test-zone"
            name = "example.com"
            zoneConfig = new zone.ZoneConfig {
                comment = "test comment"
            }
        })
        let (pklMap = gen.genPklToMap(z.toDynamic()))
        let (imports = gen.generateImportStatements(pklMap))
        imports.contains("@testprovider/dns/zone.pkl")
    }

    ["getImportInfo resolves package URI for SubResource class"] {
        // ZoneConfig is defined in @testprovider/dns/zone.pkl.
        // getImportInfo should return "zone" (the simple module name).
        let (importInfo = gen.getImportInfo(zone.ZoneConfig))
        importInfo == "zone"
    }

    ["getPackageName resolves package name for SubResource class"] {
        // ZoneConfig lives in the testprovider package.
        gen.getPackageName(zone.ZoneConfig) == "testprovider"
    }

    // --- Generalized import statement tests (plain Typed, not SubResource) ---

    ["generateImportStatements collects plain Typed imports"] {
        // DeploymentConfig is a plain class (not SubResource) from @testprovider/shared/deploymentconfig.pkl.
        // The generalized import logic should emit __import_statement__ for it.
        let (svc = new apprunner.Service {
            label = "test-svc"
            serviceName = "my-api"
            imageUri = "ecr.io/my-api:latest"
            deploymentConfig = new deploymentconfig.DeploymentConfig {
                environment = "production"
                version = "1.0.0"
                replicas = 2
            }
        })
        let (pklMap = gen.genPklToMap(svc.toDynamic()))
        let (imports = gen.generateImportStatements(pklMap))
        imports.contains("@testprovider/shared/deploymentconfig.pkl")
    }

    ["getImportInfo resolves package URI for plain Typed class"] {
        let (importInfo = gen.getImportInfo(deploymentconfig.DeploymentConfig))
        importInfo == "deploymentconfig"
    }

    ["getPackageName resolves package name for plain Typed class"] {
        gen.getPackageName(deploymentconfig.DeploymentConfig) == "testprovider"
    }

    // --- FakeEmbed rendering tests ---

    ["FakeEmbed: genMapToPklStringWithTypes renders formae.embed"] {
        // A resource map containing a FakeEmbed value in one of its fields.
        // We construct the map that parseValueEnhanced would produce for a FakeEmbed
        // and verify that genMapToPklStringWithTypes emits formae.embed(""".
        // The FakeParts list alternates String literals and $res maps.
        // Use Dynamic (not Map) to match JSON-deserialized production type.
        let (resMap = new Dynamic {
            ["$res"] = true
            ["$label"] = "kvs"
            ["$type"] = "TestProvider::EC2::VPC"
            ["$stack"] = "default"
            ["$property"] = "VpcId"
        })
        let (fakeEmbedMap = new Dynamic {
            ["__type__"] = "FakeEmbed"
            ["FakeParts"] = List("cf.kvs('", resMap, "')")
        })
        let (resourceMap = Map("functionCode", fakeEmbedMap))
        let (rendered = gen.genMapToPklStringWithTypes("TestResource", resourceMap, "test"))
        // Single-line form. A multi-line """ rendering would produce invalid PKL
        // (content on the same line as """) and break extract re-eval.
        rendered.contains("formae.embed(\"") && !rendered.contains("formae.embed(\"\"\"")
    }

    ["FakeEmbed: rendered output contains PKL interpolation marker"] {
        // Use Dynamic (not Map) to match JSON-deserialized production type.
        let (resMap = new Dynamic {
            ["$res"] = true
            ["$label"] = "kvs"
            ["$type"] = "TestProvider::EC2::VPC"
            ["$stack"] = "default"
            ["$property"] = "VpcId"
        })
        let (fakeEmbedMap = new Dynamic {
            ["__type__"] = "FakeEmbed"
            ["FakeParts"] = List("prefix", resMap, "suffix")
        })
        let (resourceMap = Map("code", fakeEmbedMap))
        let (rendered = gen.genMapToPklStringWithTypes("TestResource", resourceMap, "test"))
        rendered.contains("\\(")
    }

    // --- String escaping (roundtrip) tests ---

    ["String type conversion preserves quotes (escaping is a serialization concern)"] {
        // Type conversion must NOT escape quotes; escaping belongs only to the
        // serialization stage (escapeString). If it escapes here too, the value
        // gets double-escaped: " -> \" -> \\\" and the extract->apply roundtrip
        // sees phantom drift.
        gen.apply(SimpleFoo, new Dynamic { x = 1; name = "a\"b"; label = "q" }).name == "a\"b"
    }

    ["String serialization escapes quotes exactly once (no double-escape)"] {
        let (applied = gen.apply(SimpleFoo, new Dynamic { x = 1; name = "a\"b"; label = "q" }))
        let (pklMap = gen.genPklToMap(applied.toDynamic()))
        let (rendered = gen.genMapToPklStringWithTypes("SimpleFoo", pklMap, "test"))
        // Correct output contains: name = "a\"b" (single backslash before the quote).
        // The double-escape bug would render a\\\"b, which does not contain a\"b.
        rendered.contains("name = \"a\\\"b\"")
    }

    ["EdgeFunction code body roundtrips with single escaping"] {
        // A Supabase EdgeFunction inline body containing double-quotes.
        // Extract must escape each quote exactly once so the
        // generated forma parses back to the original source (no phantom drift).
        let (body = "Deno.serve(() => new Response(\"Hello from formae!\"))")
        let (applied = gen.apply(SimpleFoo, new Dynamic { x = 1; name = body; label = "fn" }))
        let (rendered = gen.genMapToPklStringWithTypes("SimpleFoo", gen.genPklToMap(applied.toDynamic()), "test"))
        // type conversion preserves the body verbatim ...
        applied.name == body &&
        // ... and serialization renders it single-escaped.
        rendered.contains("name = \"Deno.serve(() => new Response(\\\"Hello from formae!\\\"))\"")
    }

    ["duplicate Typed values produce single import after dedup"] {
        // Two SubResource instances in the same resource should not
        // produce duplicate __import_statement__ entries after dedup.
        let (z = new zone.Zone {
            label = "test-zone"
            name = "example.com"
            zoneConfig = new zone.ZoneConfig {
                comment = "primary"
            }
            loggingConfig = new zone.LoggingConfig {
                logGroupArn = "arn:aws:logs:us-east-1:123456789:log-group:test"
            }
        })
        let (pklMap = gen.genPklToMap(z.toDynamic()))
        let (imports = gen.generateImportStatements(pklMap))
        let (zoneImports = imports.filter((i) -> i == "@testprovider/dns/zone.pkl"))
        // collectImports may return duplicates but the caller (pklGenerator) dedups
        // Here we verify the imports are at least present
        imports.contains("@testprovider/dns/zone.pkl")
    }

    // --- Absent property vs. schema default ---

    ["Nested mutually-exclusive fields apply successfully when exactly one is set"] {
        // XorStep.run carries a constraint referencing its sibling `uses`.
        // Extraction must not evaluate that constraint against an absent field's
        // schema default; it should only see the actually-extracted value.
        let (result = gen.apply(WorkflowResource, workflowProperties))
        let (step = result.steps.toList()[0])
        step.run == null && step.uses == "actions/checkout@v4"
    }

    ["Absent non-nullable property with a default still injects that default"] {
        let (result = gen.apply(DefaultsResource, defaultsProperties))
        result.retries == 3
    }

    ["Absent nullable property with an explicit default is emitted as null, not the default"] {
        let (result = gen.apply(DefaultsResource, defaultsProperties))
        result.mode == null
    }

    ["Round-trip stays a no-op: the absent nullable field is dropped on render and its default re-applies on reconstruction"] {
        // Extraction represents the absent nullable field as null, so rendering
        // the resource drops it from the emitted output entirely...
        let (extracted = gen.apply(DefaultsResource, defaultsProperties))
        let (rendered = gen.genPklToMapWithTypes(new Dynamic { res = extracted }) as Map)
        let (renderedRes = rendered["res"] as Map)
        // ...and reconstructing the resource without that field restores the
        // schema default, so extract -> reapply does not change the value.
        let (reapplied = new DefaultsResource { label = "roundtrip" })
        !renderedRes.containsKey("mode") && renderedRes["retries"] == 3 && reapplied.mode == "auto"
    }

    // --- Union member selection ---

    ["Union member whose property cannot convert falls through to the member that fits"] {
        let (result = gen.attemptApply(IntThenStrResource, stringHolderProperties))
        !(result is gen.GenerationFailure) &&
        (result as IntThenStrResource).holder is StrHolder
    }

    ["Reordering a union whose first member cannot convert selects the same member"] {
        let (result = gen.attemptApply(StrThenIntResource, stringHolderProperties))
        !(result is gen.GenerationFailure) &&
        (result as StrThenIntResource).holder is StrHolder
    }

    ["Union member whose constraint is violated falls through to the member that fits"] {
        let (result = gen.attemptApply(XorThenStrResource, stringStepProperties))
        !(result is gen.GenerationFailure) &&
        (result as XorThenStrResource).step is StrHolder
    }

    ["Reordering a union with a constrained member selects the same member"] {
        let (result = gen.attemptApply(StrThenXorResource, stringStepProperties))
        !(result is gen.GenerationFailure) &&
        (result as StrThenXorResource).step is StrHolder
    }

    ["A value fitting no union member yields a failure value, not a hard error"] {
        gen.attemptApply(IntThenStrResource, unmatchableHolderProperties) is gen.GenerationFailure
    }

    ["A property conversion skips is not evaluated while selecting a union member"] {
        // UnsafeDefaultHolder fits the value; only its skipped `output` property
        // is unevaluatable. Selection must scope itself to what conversion
        // populated, so the member still wins.
        let (result = gen.attemptApply(SkippedDefaultResource, skippedDefaultProperties))
        !(result is gen.GenerationFailure) &&
        (result as SkippedDefaultResource).holder is UnsafeDefaultHolder
    }

    ["A union member missing a required property falls through to the member that has it"] {
        let (result = gen.attemptApply(EmailThenWebhookResource, new Dynamic {
            settings = new Dynamic { url = "https://example.test/hook" }
            label = "notify"
        }))
        !(result is gen.GenerationFailure) &&
        (result as EmailThenWebhookResource).settings is WebhookSettings
    }

    ["Reordering a union whose first member has the required property selects the same member"] {
        let (result = gen.attemptApply(WebhookThenEmailResource, new Dynamic {
            settings = new Dynamic { url = "https://example.test/hook" }
            label = "notify"
        }))
        !(result is gen.GenerationFailure) &&
        (result as WebhookThenEmailResource).settings is WebhookSettings
    }

    ["A union selects the member whose required property the value carries"] {
        let (result = gen.attemptApply(EmailThenWebhookResource, new Dynamic {
            settings = new Dynamic { addresses = "a@b" }
            label = "notify"
        }))
        !(result is gen.GenerationFailure) &&
        (result as EmailThenWebhookResource).settings is EmailSettings
    }

    ["Reordering a union whose second member has the required property selects the same member"] {
        let (result = gen.attemptApply(WebhookThenEmailResource, new Dynamic {
            settings = new Dynamic { addresses = "a@b" }
            label = "notify"
        }))
        !(result is gen.GenerationFailure) &&
        (result as WebhookThenEmailResource).settings is EmailSettings
    }

    ["A union member whose absent property has a schema default still fits an empty value"] {
        // The default is what the property resolves to, so nothing is missing
        // and the member stays in the running.
        let (result = gen.attemptApply(StrThenDefaultedResource, new Dynamic {
            holder = new Dynamic {}
            label = "defaulted"
        }))
        !(result is gen.GenerationFailure) &&
        (result as StrThenDefaultedResource).holder is DefaultedHolder &&
        ((result as StrThenDefaultedResource).holder as DefaultedHolder).retries == 3
    }

    ["A union member with only optional properties fits an empty value"] {
        let (result = gen.attemptApply(AllOptionalThenStrResource, new Dynamic {
            holder = new Dynamic {}
            label = "optional"
        }))
        !(result is gen.GenerationFailure) &&
        (result as AllOptionalThenStrResource).holder is AllOptionalHolder &&
        ((result as AllOptionalThenStrResource).holder as AllOptionalHolder).a == null &&
        ((result as AllOptionalThenStrResource).holder as AllOptionalHolder).b == null
    }

    ["A union member missing a property it inherits falls through to the member that fits"] {
        // `kind` comes from the base class, and counts exactly as a declared
        // property does.
        let (result = gen.attemptApply(KindedThenStrResource, new Dynamic {
            holder = new Dynamic { n = "abc" }
            label = "kinded"
        }))
        !(result is gen.GenerationFailure) &&
        (result as KindedThenStrResource).holder is StrHolder
    }

    ["A union member carrying its inherited property is selected"] {
        let (result = gen.attemptApply(KindedThenStrResource, new Dynamic {
            holder = new Dynamic { n = "abc"; kind = "email" }
            label = "kinded"
        }))
        !(result is gen.GenerationFailure) &&
        (result as KindedThenStrResource).holder is KindedHolder &&
        ((result as KindedThenStrResource).holder as KindedHolder).kind == "email"
    }

    // --- A scalar union keeps the member the value already belongs to ---

    ["Text in a number-or-text field stays text however the union orders its members"] {
        // Re-applying a title extracted as a number is rejected by the provider
        // the field came from, so the member the value already is decides.
        convertedSetting(IntThenTextResource, "2026") is String &&
        convertedSetting(TextThenIntResource, "2026") is String
    }

    ["A number in a text-or-number field stays a number however the union orders its members"] {
        convertedSetting(TextThenIntResource, 5) is Int &&
        convertedSetting(IntThenTextResource, 5) is Int
    }

    ["Text in a boolean-or-text field stays text however the union orders its members"] {
        convertedSetting(BoolThenTextResource, "true") is String &&
        convertedSetting(TextThenBoolResource, "true") is String
    }

    ["A boolean in a text-or-boolean field stays a boolean however the union orders its members"] {
        convertedSetting(TextThenBoolResource, true) is Boolean &&
        convertedSetting(BoolThenTextResource, true) is Boolean
    }

    ["Overlapping scalar members resolve to the one declared first"] {
        // An Int is an instance of both members, and the first declared wins:
        // the Number member returns it unchanged rather than a member being
        // scored as the closer fit.
        convertedSetting(NumberThenIntResource, 5) is Int &&
        // Text is an instance of neither, so it converts in declaration order
        // and comes out as the first member's conversion of it.
        convertedSetting(NumberThenIntResource, "5") is Float
    }

    ["A nullable scalar union keeps an absent value null and text text"] {
        convertedSetting(NullableScalarUnionResource, null) == null &&
        convertedSetting(NullableScalarUnionResource, "2026") is String
    }

    ["A nullable member of a scalar union matches only what it wraps"] {
        convertedSetting(NullableIntThenTextResource, "2026") is String &&
        convertedSetting(NullableIntThenTextResource, 5) is Int &&
        // Declared after the text member, so only unwrapping it keeps the
        // number a number.
        convertedSetting(TextThenNullableIntResource, 5) is Int
    }

    ["A scalar member declared through a type alias matches what the alias refers to"] {
        convertedSetting(AliasedIntThenTextResource, "2026") is String &&
        convertedSetting(AliasedIntThenTextResource, 5) is Int &&
        // Declared after the text member, so only following the alias to its
        // referent keeps the number a number.
        convertedSetting(TextThenAliasedIntResource, 5) is Int
    }

    ["A value matches a member of a class it is a kind of"] {
        // An Int is a Number, and the Number member holds it as it stands
        // rather than the text member declared before it reading it as text.
        convertedSetting(TextThenNumberResource, 5) is Int
    }

    ["Text in a structured-or-text field stays the text it was stored as"] {
        // The structured member reads data out of text that looks like JSON, so
        // text a provider stored as text would come back as an object and be
        // re-applied as one.
        convertedSetting(DynamicThenTextResource, "{\"a\": 1}") == "{\"a\": 1}"
    }

    ["A string literal member matches the text it declares"] {
        convertedSetting(IntThenLiteralResource, "2026") == "2026" &&
        convertedSetting(IntThenLiteralResource, "auto") == "auto" &&
        convertedSetting(IntThenLiteralResource, 5) is Int &&
        // Declared after the boolean member, which would otherwise parse the
        // literal's own text into a boolean.
        convertedSetting(BoolThenLiteralResource, "true") == "true"
    }

    ["A union of members that convert nothing of one another resolves in declaration order"] {
        // Neither member reads its own type out of the other's values, so the
        // structured value is left to the member declared first.
        convertedSetting(MapThenDynamicResource, new Dynamic { a = "1" }) is Mapping
    }

    ["A member that is itself a union matches what its own members match"] {
        convertedSetting(NestedScalarUnionThenTextResource, 5) is Int &&
        convertedSetting(TextThenNestedScalarUnionResource, 5) is Int
    }

    // --- Conversion outside a union still coerces between scalar types ---

    ["A number-typed field outside a union still converts text into a number"] {
        gen.apply(SimpleFoo, new Dynamic { x = "5"; name = "n"; label = "coerce" }).x == 5
    }

    ["A text-typed field outside a union still converts a number into text"] {
        gen.apply(SimpleFoo, new Dynamic { x = 1; name = 5; label = "coerce" }).name == "5"
    }

    // --- Resource references in union-typed fields ---

    ["A resource reference in a union-typed field selects the resolvable member"] {
        selectedMember(ScalarOrRefResource, reference(null)) == "FakeResolvable"
    }

    ["A resource reference still selects the resolvable member when the envelope omits a carrier"] {
        // The recorded value, the stack and the property are all optional parts
        // of the envelope; none of them decides whether the value is a reference.
        selectedMember(ScalarOrRefResource, reference("$value")) == "FakeResolvable" &&
        selectedMember(ScalarOrRefResource, reference("$stack")) == "FakeResolvable" &&
        selectedMember(ScalarOrRefResource, reference("$property")) == "FakeResolvable"
    }

    ["A resource reference still selects the resolvable member when the recorded value is not text"] {
        // The recorded value is a copy of whatever the referenced property
        // holds, so it takes that property's type — it never decides the member.
        selectedMember(ScalarOrRefResource, referenceValued(8080)) == "FakeResolvable" &&
        selectedMember(ScalarOrRefResource, referenceValued(true)) == "FakeResolvable"
    }

    ["A resource reference wins over a structured sibling member"] {
        // Losing here would turn the reference into literal map data, which
        // renders as a copy of the referenced value instead of a reference.
        selectedMember(RefOrMapResource, reference(null)) == "FakeResolvable" &&
        selectedMember(RefOrMapResource, reference("$value")) == "FakeResolvable" &&
        selectedMember(RefOrMapResource, reference("$stack")) == "FakeResolvable" &&
        selectedMember(RefOrMapResource, reference("$property")) == "FakeResolvable"
    }

    // --- Envelopes handed to the handlers that pass a map through as data ---

    ["An Any-typed field keeps a reference envelope as it stands"] {
        let (target = renderedTarget(AnyFieldResource, reference(null)))
        target.toMap()["$res"] == true &&
        target.toMap()["$label"] == "vpc" &&
        target.toMap()["$type"] == "TestProvider::EC2::VPC"
    }

    ["An Any-typed field still unwraps a recorded value to the value itself"] {
        renderedTarget(AnyFieldResource, recordedValue(null)) == "s3cret"
    }

    ["A Dynamic-typed field keeps an envelope as it stands"] {
        renderedTarget(DynamicFieldResource, reference(null)).toMap()["$res"] == true &&
        renderedTarget(DynamicFieldResource, recordedValue(null)).toMap()["$value"] == "s3cret" &&
        renderedTarget(DynamicFieldResource, embedded(new Listing { "a" })).toMap()["$embed"] == true
    }

    ["A Mapping-typed field converts an envelope entry by entry"] {
        renderedTarget(MapFieldResource, reference(null)).toMap()["$res"] == true &&
        renderedTarget(MapFieldResource, recordedValue(null)).toMap()["$strategy"] == "Update" &&
        renderedTarget(MapFieldResource, embedded(new Listing { "a" })).toMap()["$embed"] == true
    }

    // --- An envelope selects the union member of its own family ---

    ["A reference in a map-or-reference field selects the reference, not a copy of the envelope"] {
        // The map member converts an envelope into a literal copy of itself, so
        // the reference would be frozen into data and re-applied as settings
        // named $label and $res.
        selectedMember(MapThenRefResource, reference(null)) == "FakeResolvable"
    }

    ["A reference selects the reference member however the union orders its members"] {
        selectedMember(StrMapThenRefResource, reference(null)) == "FakeResolvable" &&
        selectedMember(RefThenAnyMapResource, reference(null)) == "FakeResolvable"
    }

    ["A reference member declared nullable or through a type alias is still a reference member"] {
        selectedMember(MapThenNullableRefResource, reference(null)) == "FakeResolvable" &&
        selectedMember(MapThenAliasedRefResource, reference(null)) == "FakeResolvable"
    }

    ["A reference nested inside a union member selects the reference"] {
        // A parenthesised member stays a union of its own rather than being
        // folded into the union around it, so the reference sits one level below
        // the members preference looks at.
        selectedMember(MapThenNestedRefResource, reference(null)) == "FakeResolvable" &&
        selectedMember(NestedRefThenMapResource, reference(null)) == "FakeResolvable" &&
        selectedMember(MapThenAliasedUnionResource, reference(null)) == "FakeResolvable"
    }

    ["A member naming several envelope families is a member of each of them"] {
        // formae.ValueSource names four families at once, so the member holding
        // it is the member of whichever of them an envelope belongs to.
        selectedMember(TextOrValueSourceResource, reference(null)) == "FakeResolvable" &&
        selectedMember(TextOrValueSourceResource, recordedValue(null)) == "FakeValue" &&
        selectedMember(TextOrValueSourceResource, binding(null)) == "FakeGeneratorOutput"
    }

    ["A member naming several envelope families is preferred over a map member"] {
        // A map member holds the very map an envelope arrives as, so an envelope
        // reaches the member naming the alias only because that member is
        // preferred over the map beside it.
        selectedMember(MapThenValueSourceResource, reference(null)) == "FakeResolvable" &&
        selectedMember(MapThenValueSourceResource, recordedValue(null)) == "FakeValue" &&
        selectedMember(MapThenValueSourceResource, binding(null)) == "FakeGeneratorOutput"
    }

    ["A reference missing an optional part still selects the reference member over a map member"] {
        selectedMember(MapThenRefResource, reference("$value")) == "FakeResolvable" &&
        selectedMember(MapThenRefResource, reference("$stack")) == "FakeResolvable" &&
        selectedMember(MapThenRefResource, reference("$property")) == "FakeResolvable" &&
        selectedMember(MapThenRefResource, reference("$label")) == "FakeResolvable"
    }

    ["A recorded value selects the value member however the union orders its members"] {
        selectedMember(MapThenValueResource, recordedValue(null)) == "FakeValue" &&
        selectedMember(ValueThenMapResource, recordedValue(null)) == "FakeValue"
    }

    ["An embedded template selects the embedded member however the union orders its members"] {
        let (env = embedded(new Listing { "echo vpc="; reference(null); " done" }))
        selectedMember(MapThenEmbedResource, env) == "FakeEmbed" &&
        selectedMember(EmbedThenMapResource, env) == "FakeEmbed"
    }

    // --- Data that only looks like an envelope stays data ---

    ["Plain nested data in a reference-or-map field extracts as data"] {
        // The reference member is declared first, and an object it cannot be
        // built from must not become a reference with nothing to point at.
        renderedTarget(RefOrMapResource, new Mapping { ["recipient"] = "#alerts" }).toMap() ==
            Map("recipient", "#alerts")
    }

    ["Plain nested data extracts as data however the union orders its members"] {
        renderedTarget(MapThenRefResource, new Mapping { ["recipient"] = "#alerts" }).toMap() ==
            Map("recipient", "#alerts") &&
        renderedTarget(RefThenAnyMapResource, new Mapping { ["recipient"] = "#alerts" }).toMap() ==
            Map("recipient", "#alerts")
    }

    ["A map carrying a $res key that is not the marker extracts as data"] {
        // Only the boolean true marks a reference; a map of the author's own
        // with a key of that name is data, in a union and on its own.
        let (odd = new Mapping { ["$res"] = "yes"; ["region"] = "eu-west-1" })
        let (asData = Map("$res", "yes", "region", "eu-west-1"))
        renderedTarget(MapFieldResource, odd).toMap() == asData &&
        renderedTarget(MapThenRefResource, odd).toMap() == asData &&
        renderedTarget(RefThenAnyMapResource, odd).toMap() == asData
    }

    ["A $res key holding false or text is not a reference"] {
        selectedMember(MapThenRefResource, referenceWith("$res", false)) == "Mapping" &&
        selectedMember(MapThenRefResource, referenceWith("$res", "x")) == "Mapping" &&
        selectedMember(RefThenAnyMapResource, referenceWith("$res", false)) == "Mapping" &&
        selectedMember(RefThenAnyMapResource, referenceWith("$res", "x")) == "Mapping"
    }

    ["A recorded value missing its visibility or strategy is not a value envelope"] {
        selectedMember(MapThenValueResource, recordedValue("$visibility")) == "Mapping" &&
        selectedMember(MapThenValueResource, recordedValue("$strategy")) == "Mapping" &&
        selectedMember(ValueThenMapResource, recordedValue("$visibility")) == "Mapping" &&
        selectedMember(ValueThenMapResource, recordedValue("$strategy")) == "Mapping"
    }

    ["An envelope is never preferred over a member of another family"] {
        // Preference is family-scoped: a recorded value does not select a
        // reference member, and a reference does not select a value member.
        selectedMember(MapThenValueResource, reference(null)) == "Mapping" &&
        selectedMember(MapThenEmbedResource, reference(null)) == "Mapping" &&
        selectedMember(MapThenRefResource, recordedValue(null)) == "Mapping"
    }

    // --- An envelope-class field requires its envelope ---

    ["A reference-typed field given plain data reports a failure instead of a reference with no target"] {
        let (message = renderFailure(RefFieldResource, new Mapping { ["recipient"] = "#alerts" }))
        message != null && message.contains("$res")
    }

    ["A value-typed field given plain data reports a failure"] {
        let (message = renderFailure(ValueFieldResource, new Mapping { ["recipient"] = "#alerts" }))
        message != null && message.contains("$value")
    }

    ["An embedded-typed field given plain data reports a failure"] {
        let (message = renderFailure(EmbedFieldResource, new Mapping { ["recipient"] = "#alerts" }))
        message != null && message.contains("$embed")
    }

    ["An envelope-class field still accepts an envelope of another family"] {
        // The marker a field's class is built from is required, but which family
        // the marker belongs to is not checked: a target typed as one family
        // converts an envelope of another exactly as it always has.
        selectedMember(RefFieldResource, recordedValue(null)) == "FakeValue"
    }

    ["A reference to another resource's secret resolves in a text-or-secret field"] {
        // The shape a schema gives a field holding either a literal or a secret.
        // A reference is not the family that field's class belongs to, and still
        // has to render as a reference rather than be rejected.
        selectedMember(TextOrSecretResource, reference(null)) == "FakeResolvable"
    }

    ["An embedded template that was never split into parts renders as the envelope it arrived as"] {
        // Extract pre-processing rewrites {$embed, $template} into
        // {$embed, $templateParts}, but passes a template it cannot split
        // through unchanged, so the unsplit shape still arrives here — and has
        // to render back into a forma that reproduces the envelope.
        let (unsplit = new Mapping { ["$embed"] = true; ["$template"] = "echo vpc=" })
        let (rendered = gen.genMapToPklStringWithTypes(
            "EmbedFieldResource",
            gen.genPklToMap(new Dynamic { target = renderedTarget(EmbedFieldResource, unsplit) }),
            "test"))
        rendered.contains("new formae.Embedded {") &&
        rendered.contains("$embed = true") &&
        rendered.contains("$template = \"echo vpc=\"")
    }

    ["An unsplit embedded template selects the embedded member of a union"] {
        let (unsplit = new Mapping { ["$embed"] = true; ["$template"] = "echo vpc=" })
        selectedMember(MapThenEmbedResource, unsplit) == "Embedded" &&
        selectedMember(EmbedThenMapResource, unsplit) == "Embedded"
    }

    ["An embedded template carrying no parts at all reports a failure"] {
        let (message = renderFailure(EmbedFieldResource, embedded(null)))
        message != null && message.contains("$templateParts")
    }

    // --- A generator binding ---

    ["A generator binding selects the generator-output member however the union orders its members"] {
        selectedMember(MapThenGenResource, binding(null)) == "FakeGeneratorOutput" &&
        selectedMember(GenThenMapResource, binding(null)) == "FakeGeneratorOutput"
    }

    ["A binding carrying the keys of a recorded value is still read as a binding"] {
        // A resolved binding is stored with the digest of the drawn value, and
        // with the visibility and strategy it was recorded under, which is the
        // shape of a recorded value. Its own marker decides, so it is never
        // read as the value written beside it.
        selectedMember(GenFieldResource, resolvedBinding()) == "FakeGeneratorOutput" &&
        selectedMember(MapThenGenResource, resolvedBinding()) == "FakeGeneratorOutput"
    }

    ["A $gen key holding false or text is not a binding"] {
        selectedMember(MapThenGenResource, binding(null).toMap().put("$gen", false).toMapping()) == "Mapping" &&
        selectedMember(MapThenGenResource, binding(null).toMap().put("$gen", "yes").toMapping()) == "Mapping"
    }

    ["A generator-output-typed field given plain data reports a failure"] {
        let (message = renderFailure(GenFieldResource, new Mapping { ["recipient"] = "#alerts" }))
        message != null && message.contains("$gen")
    }

    ["A binding naming no generator or no output reports a failure"] {
        // Both parts are required, because the rendered reference is an
        // expression built from them and there is nothing to emit without one.
        let (noLabel = renderFailure(GenFieldResource, binding("$label")))
        let (noOutput = renderFailure(GenFieldResource, binding("$output")))
        noLabel != null && noLabel.contains("$label") &&
        noOutput != null && noOutput.contains("$output")
    }

    ["A binding renders as the output accessor of the local declared for its generator"] {
        // pklGenerator names the local it declares for a generator from that
        // generator's label in camel case, so the rendered reference has to
        // agree with the same derivation or it names a local that was never
        // declared.
        let (rendered = gen.genMapToPklStringWithTypes(
            "GenFieldResource",
            gen.genPklToMap(new Dynamic { target = renderedTarget(GenFieldResource, binding(null)) }),
            "test"))
        rendered.contains("target = dbPasswordGen.gen.value")
    }

    ["A rendered binding emits nothing of the envelope the accessor derives"] {
        // The envelope's members are fixed on formae.GeneratorOutput, so
        // emitting any of them yields a file that cannot be assigned to.
        let (rendered = gen.genMapToPklStringWithTypes(
            "GenFieldResource",
            gen.genPklToMap(new Dynamic { target = renderedTarget(GenFieldResource, resolvedBinding()) }),
            "test"))
        !rendered.contains("$gen") &&
        !rendered.contains("$visibility") &&
        !rendered.contains("shared-secrets") &&
        !rendered.contains("sha256:digest")
    }

    ["A binding framed inside an embedded template renders as an interpolation of its accessor"] {
        // Interpolating the accessor reproduces the framed envelope, because
        // that is what formae.GeneratorOutput renders when read as text.
        let (fakeEmbedMap = new Dynamic {
            ["__type__"] = "FakeEmbed"
            ["FakeParts"] = List("PGPASSWORD=", embeddedBindingPart(), " psql")
        })
        let (rendered = gen.genMapToPklStringWithTypes(
            "TestResource", Map("code", fakeEmbedMap), "test"))
        rendered.contains("formae.embed(\"PGPASSWORD=\\(dbPasswordGen.gen.value) psql\")")
    }

    // --- Map conversion ---

    ["A map key of the wrong type yields a failure value instead of dropping the entry"] {
        let (result = gen.attemptApply(ComplexBar, new Dynamic {
            items = new Listing { "a" }
            metadata = new Mapping {
                [1] = "one"
                ["ok"] = "two"
            }
            label = "map"
        }))
        result is gen.GenerationFailure &&
        (result as gen.GenerationFailure).message.contains("Expected \"String\"")
    }

    ["A map value that cannot be converted yields a failure value instead of dropping the entry"] {
        let (result = gen.attemptApply(IntMapResource, new Dynamic {
            counts = new Mapping { ["a"] = "abc" }
            label = "map"
        }))
        result is gen.GenerationFailure &&
        (result as gen.GenerationFailure).message.contains("cannot be parsed as Int")
    }

    ["A map value that converts is still coerced to the declared value type"] {
        let (result = gen.attemptApply(IntMapResource, new Dynamic {
            counts = new Mapping { ["a"] = "5"; ["b"] = "6" }
            label = "map"
        }))
        !(result is gen.GenerationFailure) &&
        (result as IntMapResource).counts.toMap() == Map("a", 5, "b", 6)
    }

    ["A map entry that cannot be converted names the key it came from"] {
        let (result = gen.attemptApply(IntMapResource, new Dynamic {
            counts = new Mapping { ["a"] = "5"; ["b"] = "abc" }
            label = "map"
        }))
        result is gen.GenerationFailure &&
        gen.failureMessage(result as gen.GenerationFailure).contains("counts[\"b\"]")
    }

    // --- List conversion ---

    ["A map element of a list that cannot be converted names the element index"] {
        let (result = gen.attemptApply(MapListResource, new Dynamic {
            groups = new Listing {
                new Mapping {
                    ["Name"] = "web"
                    ["enabled"] = true
                }
            }
            label = "list"
        }))
        result is gen.GenerationFailure &&
        gen.failureMessage(result as gen.GenerationFailure).contains("groups[0][\"enabled\"]")
    }

    ["A typed element of a list that cannot be converted names the element index"] {
        let (result = gen.attemptApply(HolderListResource, new Dynamic {
            holders = new Listing { new Dynamic { n = true } }
            label = "list"
        }))
        result is gen.GenerationFailure &&
        gen.failureMessage(result as gen.GenerationFailure).contains("holders[0][\"n\"]")
    }

    // --- Rendering a resource reports what failed ---

    ["Rendering a resource whose property cannot be converted names the resource and the property"] {
        let (message = module.catch(() -> gen.applyResource(IntMapResource, new Dynamic {
            counts = new Mapping { ["a"] = "abc" }
            label = "map"
        }, "Cannot render resource \"map\" in stack \"default\"")))
        message.contains("Cannot render resource \"map\" in stack \"default\"") &&
        message.contains("counts[\"a\"]") &&
        message.contains("cannot be parsed as Int")
    }

    ["A resource missing a property the schema requires is still rendered, partially"] {
        // A resource is rendered on its own, with no alternative to fall
        // through to, so an absent property is simply left out of the result.
        // A union member missing one is rejected instead, because there the
        // absence is what tells the members apart.
        let (rendered = gen.applyResource(TestResource, new Dynamic {
            size = 1024
            label = "my-bucket"
        }, "Cannot render resource \"my-bucket\" in stack \"default\""))
        !rendered.containsKey("bucketName") &&
        rendered["size"] == 1024 &&
        rendered["label"] == "my-bucket"
    }

    // --- Malformed envelopes report a failure instead of aborting ---

    ["A resource reference carrying no resource type yields a failure value"] {
        let (result = gen.attemptApply(HolderResource, new Dynamic {
            holder = new Dynamic {
                ["$res"] = true
                ["$label"] = "vpc"
                ["$property"] = "VpcId"
            }
            label = "ref"
        }))
        result is gen.GenerationFailure &&
        (result as gen.GenerationFailure).message.contains("$type must be a String")
    }

    ["A resource reference whose property path is not a String yields a failure value"] {
        let (result = gen.attemptApply(HolderResource, new Dynamic {
            holder = new Dynamic {
                ["$res"] = true
                ["$label"] = "vpc"
                ["$type"] = "TestProvider::EC2::VPC"
                ["$property"] = 5
            }
            label = "ref"
        }))
        result is gen.GenerationFailure &&
        (result as gen.GenerationFailure).message.contains("$property must be a String")
    }

    ["An embedded template whose parts are not a list yields a failure value"] {
        let (result = gen.attemptApply(HolderResource, new Dynamic {
            holder = new Dynamic {
                ["$embed"] = true
                ["$templateParts"] = "cf.kvs('...')"
            }
            label = "embed"
        }))
        result is gen.GenerationFailure &&
        (result as gen.GenerationFailure).message.contains("Expected \"Listing|List|Dynamic\"")
    }

    // --- A diagnostic names types, never the value it was given ---

    ["A union no member accepts names every member, its reason and the value's type"] {
        settingFailure(IntThenBoolResource) ==
            "setting: No member of this union accepted a String value. "
            + "Int: Expected \"Int\" but got \"String that cannot be parsed as Int\"; "
            + "Boolean: Expected \"Boolean\" but got \"String that cannot be parsed as Boolean\"" &&
        !settingFailure(IntThenBoolResource).contains(sentinel)
    }

    ["A union reports its members in the order the schema declares them"] {
        settingFailure(BoolThenIntResource) ==
            "setting: No member of this union accepted a String value. "
            + "Boolean: Expected \"Boolean\" but got \"String that cannot be parsed as Boolean\"; "
            + "Int: Expected \"Int\" but got \"String that cannot be parsed as Int\""
    }

    ["Members that reject a value for the same reason are reported once, together"] {
        settingFailure(IntThenAliasedIntResource) ==
            "setting: No member of this union accepted a String value. "
            + "Int, Year: Expected \"Int\" but got \"String that cannot be parsed as Int\""
    }

    ["A union failure names the class of the value and locates the member reasons"] {
        failureFor(IntThenStrResource, unmatchableHolderProperties) ==
            "holder: No member of this union accepted a Dynamic value. "
            + "IntHolder: n: Expected \"Int\" but got \"Listing\"; "
            + "StrHolder: n: Expected \"String\" but got \"Listing\""
    }

    ["A union of unions keeps its failure bounded"] {
        // Every member's reason is itself a union's reasons, so without a bound
        // the message grows with every level of nesting.
        settingFailure(NestedUnionResource).length < 600 &&
        settingFailure(DeeperUnionResource).length <= settingFailure(NestedUnionResource).length &&
        settingFailure(NestedUnionResource).startsWith(
            "setting: No member of this union accepted a String value. ") &&
        !settingFailure(NestedUnionResource).contains(sentinel)
    }

    ["A union with more members than a message reports says how many it left out"] {
        // Ten members reject the value for ten different reasons.
        settingFailure(ManyMemberUnionResource).endsWith("; and 2 more") &&
        settingFailure(ManyMemberUnionResource).contains("Int: ") &&
        settingFailure(ManyMemberUnionResource).contains("\"b\": ") &&
        !settingFailure(ManyMemberUnionResource).contains("\"d\": ")
    }

    ["A union member rejected by a deferred check reports it without the value it carried"] {
        // PKL's own diagnostic for a violated constraint quotes the value that
        // violated it, and that diagnostic is what the read-ahead catches.
        let (message = failureFor(XorThenStrResource, new Dynamic {
            step = new Dynamic {
                run = sentinel
                uses = "actions/checkout@v4"
            }
            label = "step"
        }))
        message.contains("does not satisfy its declared property types or constraints") &&
        !message.contains(sentinel)
    }

    ["A map key that is not a scalar locates a failure by its type, not its content"] {
        let (message = failureFor(IntKeyMapResource, new Dynamic {
            keyed = new Dynamic {
                [new Dynamic { secretPart = sentinel }] = "x"
            }
            label = "keyed"
        }))
        message == "keyed[Dynamic]: Expected \"Int\" but got \"Dynamic\"" &&
        !message.contains(sentinel)
    }

    ["A map key a union member reports is bracketed, not read as a property name"] {
        failureFor(MapThenIntResource, new Dynamic {
            setting = new Dynamic { [sentinel] = "abc" }
            label = "scalar"
        }) ==
            "setting: No member of this union accepted a Dynamic value. "
            + "Mapping<String, Int>: [\"\(sentinel)\"]: "
            + "Expected \"Int\" but got \"String that cannot be parsed as Int\"; "
            + "Int: Expected \"Int\" but got \"Dynamic\""
    }

    ["A reason more members share than a message names is reported shortened"] {
        settingFailure(LongLabelUnionResource) ==
            "setting: No member of this union accepted a String value. "
            + "LongLabelledIntAlpha, LongLabelledIntBravo, LongLabelledIntC...: "
            + "Expected \"Int\" but got \"String that cannot be parsed as Int\""
    }

    ["A scalar handler names the type it could not parse, never the text it was given"] {
        let (messages = List(
            failureFor(ScalarFieldsResource, new Dynamic { count = sentinel; label = "s" }),
            failureFor(ScalarFieldsResource, new Dynamic { ratio = sentinel; label = "s" }),
            failureFor(ScalarFieldsResource, new Dynamic { amount = sentinel; label = "s" }),
            failureFor(ScalarFieldsResource, new Dynamic { enabled = sentinel; label = "s" }),
            failureFor(ScalarFieldsResource, new Dynamic { timeout = sentinel; label = "s" }),
            failureFor(ScalarFieldsResource, new Dynamic { capacity = sentinel; label = "s" })
        ))
        messages.every((message) -> message.contains("cannot be parsed as")) &&
        messages.every((message) -> !message.contains(sentinel))
    }

    ["A field pinned to one text reports a different text without quoting it"] {
        settingFailure(LiteralFieldResource) ==
            "setting: Expected \"2026\" but got \"a different String\""
    }

    ["A field whose class no handler converts to names the value's type, not the value"] {
        let (message = failureFor(UnsupportedFieldResource, new Dynamic {
            span = sentinel
            label = "unsupported"
        }))
        message.contains("IntSeq") &&
        message.contains("String") &&
        !message.contains(sentinel)
    }

}
