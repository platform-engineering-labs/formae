/// Unions of unions, so that a member's reason is itself a union's reasons and
/// the message grows with every level of nesting.
local typealias ScalarsA = Int|Boolean|Duration
local typealias ScalarsB = DataSize|Float|Number
local typealias ScalarsC = ScalarsA|ScalarsB
local typealias ScalarsD = ScalarsC|ScalarsA
local typealias ScalarsE = ScalarsD|ScalarsB

@formae.ResourceHint
local class NestedUnionResource extends formae.Resource {
    type = "FakePlugin::Union::Nested"

    @formae.FieldHint
    setting: ScalarsC|ScalarsA|ScalarsB
}

@formae.ResourceHint
local class DeeperUnionResource extends formae.Resource {
    type = "FakePlugin::Union::Deeper"

    @formae.FieldHint
    setting: ScalarsE|ScalarsD|ScalarsC
}

/// A union whose first member is a map, so a failure a member reports carries a
/// map key as the outermost step of its path.
@formae.ResourceHint
local class MapThenIntResource extends formae.Resource {
    type = "FakePlugin::Union::MapThenInt"

    @formae.FieldHint
    setting: Mapping<String, Int>|Int
}

/// A union whose members are named at length and reject a value for one shared
/// reason, so the members named on that reason exceed what a message carries.
local typealias LongLabelledIntAlpha = Int
local typealias LongLabelledIntBravo = Int
local typealias LongLabelledIntCharlie = Int

@formae.ResourceHint
local class LongLabelUnionResource extends formae.Resource {
    type = "FakePlugin::Union::LongLabel"

    @formae.FieldHint
    setting: LongLabelledIntAlpha|LongLabelledIntBravo|LongLabelledIntCharlie
}

/// More members than a message reports, each rejecting a value for a reason of
/// its own.
@formae.ResourceHint
local class ManyMemberUnionResource extends formae.Resource {
    type = "FakePlugin::Union::ManyMember"

    @formae.FieldHint
    setting: Int|Boolean|Float|Number|Duration|DataSize|"a"|"b"|"c"|"d"
}

