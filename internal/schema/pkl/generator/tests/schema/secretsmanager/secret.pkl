/// A resource that reaches formae.Resource through formae.Secret rather than
/// extending it directly, mirroring the shape a provider's first-class secret
/// takes. Resource discovery matches on class identity, not on the immediate
/// superclass name.
module testprovider.secretsmanager.secret

import "@formae/formae.pkl"
import "../testprovider.pkl"

const type = "TestProvider::SecretsManager::Secret"

open class SecretResolvable extends formae.ScalarSecretResolvable {
    hidden type = module.type

    hidden valueProperty = "SecretString"
}

@testprovider.ResourceHint {
    type = module.type
    identifier = "Id"
}
open class Secret extends formae.Secret {
    hidden valueProperty = "SecretString"

    @testprovider.FieldHint
    name: String?

    @testprovider.FieldHint
    description: String?

    @testprovider.FieldHint
    secretString: (String|formae.Value|formae.SecretValue)?

    @testprovider.FieldHint
    tags: Listing<testprovider.Tag>?

    local parent = this

    hidden res: SecretResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
