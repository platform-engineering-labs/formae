/// Generates imports.pkl with wildcard imports for schema packages.
///
/// This module reads dependencies from PklProject and generates import*() calls
/// for each schema package dependency (excludes the "formae" core library).
///
/// External property `schemaVersions` (optional, format
/// "pkg=ver,pkg=ver") narrows the import glob for matching packages from
/// "@<pkg>/**/*.pkl" to the root files plus the pinned version subtree. This
/// lets versioned plugins (e.g. k8s) ship a multi-version schema tree under a
/// single PklProject and have callers select one subtree at evaluation time.
///
/// External property `schemaSubdirs` (optional, format
/// "pkg=dir;dir,pkg=dir") lists a narrowed package's top-level subdirectories
/// that are NOT version dirs — subtrees the plugin deliberately keeps
/// version-independent (e.g. k8s' helm/). The root glob matches root-level
/// FILES only and the version glob only the pinned subtree, so without these
/// globs such a module is absent from the extract typeMap and extract fails
/// with `Cannot find key "<Type>"`. Pkl cannot list directories; the caller
/// scans the install and passes the names in. Ignored for packages that aren't
/// narrowed — their unrestricted glob already covers every subdir.
///
/// Every narrowed directory is globbed twice, "<dir>/*.pkl" and
/// "<dir>/**/*.pkl", because Pkl's "**" matches ONE OR MORE intervening path
/// segments: "<dir>/**/*.pkl" alone silently skips modules sitting directly in
/// <dir>, which is the common layout for a version-independent resource
/// (helm/Release.pkl) and legal for a version subtree too.
///
/// Usage:
///   pkl eval ImportsGenerator.pkl
///
/// Output:
///   packages: Mapping<String, Mapping<String, Module>> = new Mapping {
///     ["@aws"] = import*("@aws/**/*.pkl")
///     ["@k8s"] = import*("@k8s/*.pkl")
///                + import*("@k8s/helm/*.pkl")   + import*("@k8s/helm/**/*.pkl")
///                + import*("@k8s/v1.30/*.pkl")  + import*("@k8s/v1.30/**/*.pkl")
///   }
module formae.generator.ImportsGenerator

import "PklProject"

/// Dependencies to exclude from schema imports (core libraries, not resource providers)
local excludedDependencies: List<String> = List("formae")

/// Get dependency names from PklProject, excluding core libraries
local schemaPackageNames: List<String> =
    PklProject.dependencies.keys.toList().filter((name) -> !excludedDependencies.contains(name))

/// External "pkg=ver,pkg=ver" mapping. Empty string when no versions selected.
local schemaVersionsRaw: String = read?("prop:schemaVersions") ?? ""

/// Parsed: lowercase pkg name -> version string (e.g. "v1.30").
local schemaVersions: Mapping<String, String> = new Mapping {
    for (entry in schemaVersionsRaw.split(",")) {
        when (entry.contains("=")) {
            [entry.split("=")[0].trim().toLowerCase()] = entry.split("=")[1].trim()
        }
    }
}

local function versionFor(name: String): String =
    schemaVersions.getOrNull(name.toLowerCase()) ?? ""

/// External "pkg=dir;dir,pkg=dir" mapping. Empty string when no package ships
/// version-independent subtrees.
local schemaSubdirsRaw: String = read?("prop:schemaSubdirs") ?? ""

/// Parsed: lowercase pkg name -> non-version top-level subdir names.
local schemaSubdirs: Mapping<String, List<String>> = new Mapping {
    for (entry in schemaSubdirsRaw.split(",")) {
        when (entry.contains("=")) {
            [entry.split("=")[0].trim().toLowerCase()] =
                entry.split("=")[1].split(";").map((d) -> d.trim()).filter((d) -> d != "")
        }
    }
}

/// The extra "; ...import*(...)" clauses for a narrowed package's
/// version-independent subtrees. Emitted before the pinned version subtree so
/// that subtree stays last and wins ResourcesGenerator's last-writer-wins fold
/// if the same type is defined in both.
///
/// Two globs per directory: Pkl's "**" matches one or more intervening path
/// segments, so "<dir>/**/*.pkl" alone silently skips modules sitting directly
/// in <dir> — which is the common case for a version-independent resource
/// (e.g. helm/Release.pkl).
local function subdirGlobsFor(name: String): String =
    (schemaSubdirs.getOrNull(name.toLowerCase()) ?? List())
        .map((dir) ->
            "; ...import*(\"@\(name)/\(dir)/*.pkl\")"
            + "; ...import*(\"@\(name)/\(dir)/**/*.pkl\")")
        .join("")

output {
    text = new Listing {
        "// Generated by ImportsGenerator.pkl"
        "// Do not edit manually"
        ""
        "packages: Mapping<String, Mapping<String, Module>> = new Mapping {"
        for (name in schemaPackageNames) {
            let (ver = versionFor(name))
                if (ver == "")
                    "    [\"@\(name)\"] = new Mapping { ...import*(\"@\(name)/*.pkl\"); ...import*(\"@\(name)/**/*.pkl\") }"
                else
                    "    [\"@\(name)\"] = new Mapping { ...import*(\"@\(name)/*.pkl\")\(subdirGlobsFor(name)); ...import*(\"@\(name)/\(ver)/*.pkl\"); ...import*(\"@\(name)/\(ver)/**/*.pkl\") }"
        }
        "}"
    }.join("\n")
}
