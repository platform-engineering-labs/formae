/*
 * FakeVer::Helm::Repository — nested one level inside the version-independent
 * subtree. Reached only by that directory's "**" glob, whereas its sibling
 * helm/release.pkl is reached only by the single-star glob. Both shapes have to
 * work, hence both modules.
 */
module fakever.helm.charts.repository

import "@formae/formae.pkl"
import "../../fakever.pkl"

const type = "FakeVer::Helm::Repository"

@fakever.ResourceHint {
    type = module.type
    identifier = "Name"
    portable = true
}
open class Repository extends formae.Resource {
    @fakever.FieldHint
    name: String?

    @fakever.FieldHint
    url: String?
}
