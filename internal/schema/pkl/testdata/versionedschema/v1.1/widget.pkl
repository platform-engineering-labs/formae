/*
 * FakeVer::Core::Widget as of v1.1 — same type as v1.0/widget.pkl, plus
 * `replicas`. A forma pinned to v1.1 must resolve THIS module.
 */
module fakever.v1_1.widget

import "@formae/formae.pkl"
import "../fakever.pkl"

const type = "FakeVer::Core::Widget"

open class WidgetResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden widgetName: WidgetResolvable = (this) {
        property = "Name"
    }
}

@fakever.ResourceHint {
    type = module.type
    identifier = "Name"
    portable = true
}
open class Widget extends formae.Resource {
    @fakever.FieldHint
    name: String?

    @fakever.FieldHint
    replicas: Int?

    local parent = this

    hidden res: WidgetResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
