amends "@formae/forma.pkl"
import "@formae/formae.pkl"

forma {
  local testStack = new formae.Stack {
    label = "generator-alias-test-stack"
  }
  testStack

  new formae.PasswordGenerator {
    label = "new-password"
    alias = "old-password"
    stack = testStack.res
    length = 24
  }
}
