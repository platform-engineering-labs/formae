amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@formae/debug/debug.pkl"
import "@fakeaws/fakeaws.pkl"

forma {
  local testStack = new formae.Stack {
    label = "durable"
  }
  testStack

  new formae.Target {
    label = "default-aws-target"
    config = new fakeaws.Config {
      region = "us-west-2"
    }
  }

  local pw = new formae.PasswordGenerator {
    label = "db-password"
    stack = testStack.res
  }
  pw

  when (formae.cmd() == "eval") {
    new debug.Consumer {
      label = "consumer"
      value = pw.gen.value
    }
  }
}
