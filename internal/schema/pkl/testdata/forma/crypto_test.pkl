amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@formae/debug/debug.pkl"
import "@formae/ext/crypto.pkl"
import "@fakeaws/fakeaws.pkl"

forma {
  new formae.Stack {
    label = "pel-rsa"
    description = "Stack for PEL rsa keypairs"
  }

  new formae.Target {
    label = "default-aws-target"
    config = new fakeaws.Config {
      region = "us-west-2"
    }
  }

  when (formae.cmd() == "eval") {
    new debug.Consumer {
      label = "my-consumer"
      value = crypto.keyPair("sec1", null, "256").toDynamic()
    }
  }
}
