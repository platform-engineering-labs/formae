// Shape-misuse test: amending $visibility on a GeneratorOutput to rewrite it
// away from Opaque. The $-prefixed envelope fields are fixed, so PKL eval
// fails rather than letting a plan render a generated value in cleartext.

amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@formae/debug/debug.pkl"
import "@fakeaws/fakeaws.pkl"

forma {
  local testStack = new formae.Stack {
    label = "durable"
  }
  testStack

  new formae.Target {
    label = "default-aws-target"
    config = new fakeaws.Config {
      region = "us-west-2"
    }
  }

  local pw = new formae.PasswordGenerator {
    label = "db-password"
    stack = testStack.res
  }

  new debug.Consumer {
    label = "consumer"
    value = (pw.gen.value) { $visibility = "Cleartext" }
  }
}
