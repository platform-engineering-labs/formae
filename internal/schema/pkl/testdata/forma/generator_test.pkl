amends "@formae/forma.pkl"
import "@formae/formae.pkl"

forma {
  local testStack = new formae.Stack {
    label = "generator-test-stack"
  }
  testStack

  new formae.PasswordGenerator {
    label = "db-password"
    stack = testStack.res
    length = 24
    excludeCharacters = "oO0"
  }

  new formae.PasswordGenerator {
    label = "rotating-password"
    stack = testStack.res
    symbols = true
    rotation {
      every = 30.d
    }
  }
}
