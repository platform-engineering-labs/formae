amends "formae:/Config.pkl"

agent {
    datastore {
        datastoreType = "postgres"

        postgres {
            host = "db.internal"
            port = 5432
            user = "formae"
            password = "static-fallback"
            passwordSecretArn = "arn:aws:secretsmanager:us-west-2:123456789012:secret:app/db-password-AbCdEf"
            database = "formae"
        }
    }
}
