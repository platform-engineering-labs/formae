amends "formae:/Config.pkl"

cli {
    connection = new Hosted {
        endpoint = "https://cloud.formae.ai"
        installation = "3f2b8c14-0000-4000-8000-000000000000"
        auth = new Dynamic { type = "oidc"; issuer = "https://auth.formae.ai" }
    }
}
