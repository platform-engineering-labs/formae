amends "formae:/Config.pkl"

import "formae:/Config.pkl"

local class FaiConfig extends Config.BaseOidcCredentialPluginConfig {
    issuer: String
    audience: String
}

local class DisabledBrokerConfig extends Config.BaseOidcCredentialPluginConfig {}

agent {
    oidcCredentialPlugins {
        new FaiConfig {
            type = "fai"
            issuer = "https://issuer.example.com"
            audience = "formae"
        }
        new DisabledBrokerConfig {
            type = "other"
            enabled = false
        }
    }
}
