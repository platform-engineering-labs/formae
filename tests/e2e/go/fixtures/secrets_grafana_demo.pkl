/// Demo forma: an AWS Secrets Manager secret whose value is resolved live
/// into a Grafana ContactPoint's settingsMap at apply time.
/// The credential is persisted only as a $ref — no plaintext in the datastore.

amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@aws/aws.pkl"
import "@grafana/grafana.pkl"
import "@aws/secretsmanager/secret.pkl" as secretmod
import "@grafana/alerting/contact_point.pkl" as cpmod

local awsRegion = read?("env:AWS_REGION") ?? "us-east-1"

local grafanaTarget = new formae.Target {
  label = "e2e-grafana-demo"
  namespace = "GRAFANA"
  config = new grafana.Config {
    url = "http://localhost:3333"
  }
}

local theSecret = new secretmod.Secret {
  label = "e2e-grafana-demo-secret"
  name = "formae-e2e-grafana-demo-token"
  description = "Demo: Grafana alerting token stored in AWS Secrets Manager"
  secretString = formae.value("grafana-webhook-token-demo-placeholder").opaque.setOnce
}

forma {
  new formae.Stack {
    label = "e2e-secrets-grafana-demo"
    description = "Demo: secret resolution into Grafana ContactPoint settingsMap"
  }

  new formae.Target {
    label = "e2e-aws-demo"
    config = new aws.Config {
      region = awsRegion
    }
  }

  grafanaTarget

  theSecret

  new cpmod.ContactPoint {
    label = "e2e-grafana-demo-contactpoint"
    target = grafanaTarget.res
    name = "formae-e2e-demo-webhook"
    contactPointType = "webhook"
    settingsMap = new Mapping {
      ["url"] = "https://hooks.example.com/webhook"
      ["authorization_credentials"] = theSecret.res.secretString
    }
  }
}
