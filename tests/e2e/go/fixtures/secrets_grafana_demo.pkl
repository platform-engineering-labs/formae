/// Demo forma for RFC-110 first-class secrets: a Grafana TARGET whose basic-auth
/// credentials are sourced from a single AWS Secrets Manager JSON secret. The
/// agent resolves the username and password live at the plugin-call boundary via
/// the .json() accessor — no credentials in the agent's environment, no restart.
/// The target config persists only a $ref; the plaintext never lands at rest.

amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@aws/aws.pkl"
import "@grafana/grafana.pkl"
import "@aws/secretsmanager/secret.pkl" as secretmod
import "@grafana/core/folder.pkl" as foldermod

local awsRegion = read?("env:AWS_REGION") ?? "us-east-1"

// One JSON secret holding BOTH the username and the password.
local grafanaCreds = new secretmod.Secret {
  label = "e2e-grafana-demo-creds"
  name = "formae-e2e-grafana-demo-creds-a5"
  description = "Demo: Grafana basic-auth username+password in one JSON secret"
  secretString = formae.value("{\"username\":\"admin\",\"password\":\"admin\"}").opaque.setOnce
}

// The Grafana target pulls each credential out of the ONE JSON secret with .json().
local grafanaTarget = new formae.Target {
  label = "e2e-grafana-demo"
  namespace = "GRAFANA"
  config = new grafana.Config {
    url = "http://localhost:3333"
    username = grafanaCreds.res.secretValue.json("username")
    password = grafanaCreds.res.secretValue.json("password")
  }
}

forma {
  new formae.Stack {
    label = "e2e-secrets-grafana-demo"
    description = "Demo: Grafana target credentials resolved from an AWS JSON secret"
  }

  new formae.Target {
    label = "e2e-aws-demo"
    config = new aws.Config {
      region = awsRegion
    }
  }

  grafanaTarget

  grafanaCreds

  // A Grafana resource on the target — its creation forces the target's
  // credentials to be resolved and used at the Grafana plugin-call boundary.
  new foldermod.Folder {
    label = "e2e-grafana-demo-folder"
    target = grafanaTarget.res
    title = "formae-e2e-demo"
  }
}
