/// Cascade forma for RFC-110 first-class secrets: same shape as the demo (a
/// Grafana TARGET whose basic-auth credentials come from an AWS JSON secret),
/// but used to exercise the dependency-aware DELETE cascade. Destroying just the
/// secret must, by default, ABORT (the Grafana target depends on it); with
/// --on-dependents=cascade it must tear down the dependent target and its folder
/// — resolving the target's credentials from the still-present secret so the
/// authenticated folder delete succeeds — then delete the secret last.
///
/// Distinct stack/secret-name/target/folder-title from the demo fixture so both
/// tests can run against the same AWS account and Grafana instance concurrently.

amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@aws/aws.pkl"
import "@grafana/grafana.pkl"
import "@aws/secretsmanager/secret.pkl" as secretmod
import "@grafana/core/folder.pkl" as foldermod

local awsRegion = read?("env:AWS_REGION") ?? "us-east-1"

// One JSON secret holding BOTH the username and the password.
local grafanaCreds = new secretmod.Secret {
  label = "e2e-grafana-cascade-creds"
  name = "formae-e2e-grafana-cascade-creds-c8"
  description = "Cascade: Grafana basic-auth username+password in one JSON secret"
  secretString = formae.value("{\"username\":\"admin\",\"password\":\"admin\"}").opaque.setOnce
}

// The Grafana target pulls each credential out of the ONE JSON secret with .json().
local grafanaTarget = new formae.Target {
  label = "e2e-grafana-cascade"
  namespace = "GRAFANA"
  config = new grafana.Config {
    url = "http://localhost:3333"
    username = grafanaCreds.res.secretValue.json("username")
    password = grafanaCreds.res.secretValue.json("password")
  }
}

forma {
  new formae.Stack {
    label = "e2e-secrets-grafana-cascade"
    description = "Cascade: dependency-aware delete of a secret-backed Grafana target"
  }

  new formae.Target {
    label = "e2e-aws-cascade"
    config = new aws.Config {
      region = awsRegion
    }
  }

  grafanaTarget

  grafanaCreds

  // A Grafana resource on the target — its creation forces the target's
  // credentials to be resolved and used at the Grafana plugin-call boundary,
  // and it is the resource torn down (with resolved creds) during the cascade.
  new foldermod.Folder {
    label = "e2e-grafana-cascade-folder"
    target = grafanaTarget.res
    title = "formae-e2e-cascade"
  }
}
