name = "oidc-credential-stub"
type = "oidc-credential"
version = "0.0.1"
summary = "Stub oidc-credential broker for the e2e suite"
license = "FSL-1.1-ALv2"

/// The namespace this broker serves, paired with the echo resource plugin's
/// namespace by the agent's PluginCoordinator.
namespaces {
  "OidcEcho"
}

/// Must be at least pkg/credential.MinFormaeVersion, or the agent drops this
/// broker as built against an unsupported SDK. Raise both together.
minFormaeVersion = "0.89.0"
